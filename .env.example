APP_NAME="Gamerlogue"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Rome
APP_URL=https://gamerlogue.localhost
# Comma separated. Prefer a verified HTTPS App Link over the private-use scheme: any app can
# register the latter. Keep both listed only while the clients migrate.
NATIVE_AUTH_REDIRECT_URIS=gamerlogue://auth/callback
# Fill both to serve /.well-known/assetlinks.json, which is what makes the App Link verifiable.
# Fingerprints are SHA-256, uppercase and colon-separated, comma separated between certificates.
NATIVE_AUTH_ANDROID_PACKAGE=
NATIVE_AUTH_ANDROID_FINGERPRINTS=
IGDB_PROXY_RATE_LIMIT=30
IGDB_PROXY_EVENT_CACHE_LIFETIME=5
IGDB_PROXY_EVENT_STALE_LIFETIME=10
# The docker compose service name for the app (used by Laravel Sail)
APP_SERVICE=laravel
# Sail execs as this user; our image uses www-data, not the default "sail"
APP_USER=www-data
# Used by FrankenPHP/Caddy to manage SSL certificates and stuff
SERVER_NAME=gamerlogue.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=deprecations
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
# Required in production (see compose.prod.yaml), where it must differ from DB_PASSWORD.
# Development leaves it empty and relies on MARIADB_ALLOW_EMPTY_PASSWORD.
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set this in the production environment. Leaving it on here would stop the session cookie from
# being sent back over Sail's plain HTTP and loop the local login.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Horizon only supervises Redis connections, so this cannot be the failover chain: a job that
# fell through to 'database' would sit there unprocessed, because nothing watches that connection.
QUEUE_CONNECTION=redis

CACHE_STORE=failover
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp

SAIL_XDEBUG_MODE=develop,debug,coverage

ADMIN_EMAIL=

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_URL=
OIDC_SCOPES="openid profile email"
