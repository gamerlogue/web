{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "experimentalDecorators": true,
        "strict": true,
        "isolatedModules": true,
        "lib": ["esnext", "dom", "dom.iterable"],
        "paths": {
            "~/*": [
                "./resources/ts/*"
            ],
            "@images/*": [
                "./resources/images/*"
            ],
            "@animations/*": [
                "./resources/animations/*"
            ],
        }
    }
}
