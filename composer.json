{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "maicol07/account",
  "description": "Gamerlogue web application.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.5",
    "ext-fileinfo": "*",
    "ext-intl": "*",
    "ext-pdo": "*",
    "api-platform/laravel": "^4.2",
    "emargareten/inertia-modal": "^1.5",
    "inertiajs/inertia-laravel": "^2.0",
    "laravel-lang/locales": "^2.10",
    "laravel/fortify": "^1.37",
    "laravel/framework": "^13.0",
    "laravel/horizon": "^5.48",
    "laravel/octane": "^2.18",
    "laravel/pail": "^1.2",
    "laravel/pulse": "^1.8",
    "laravel/sanctum": "^4.3",
    "laravel/telescope": "^5.22",
    "laravel/tinker": "^3.0",
    "laravel/wayfinder": "^0.1.4",
    "maicol07/laravel-oidc-client": "^1.1",
    "mariusgelez/igdb-laravel": "^1.0",
    "opcodesio/log-viewer": "^3.10",
    "soved/laravel-gdpr": "^1.9"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "fumeapp/modeltyper": "^3.0",
    "larastan/larastan": "^3.10",
    "laravel-lang/lang": "^15.26",
    "laravel-lang/publisher": "^16.7",
    "laravel/boost": "^2.0",
    "laravel/pint": "^1.30",
    "laravel/pao": "^1.1",
    "laravel/sail": "^1.65",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "pestphp/pest": "^5.1",
    "pestphp/pest-plugin-laravel": "^5.0",
    "roave/security-advisories": "dev-latest",
    "spatie/laravel-error-solutions": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "pnpm install",
      "pnpm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
    ],
    "test": [
      "@php artisan config:clear --ansi @no_additional_args",
      "@php artisan test"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan lang:update"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php artisan octane:install --server=frankenphp",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "nesbot/carbon"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
